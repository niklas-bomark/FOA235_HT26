################################################################################
# Part 1

# Generate a population
set.seed(group_id)
population <- rexp(100000, rate = 1)

# Histogram
hist(population)


# Draw one sample from the population
set.seed(group_id)
sample1 <- sample(population, 80)

hist(sample1)
mean(sample1)


# Generate sampling distribution, n = 80
set.seed(group_id)
means_80 <- replicate(1000, mean(sample(population, 80, replace = TRUE)))

hist(means_80)


# Generate sampling distribution, n = 3
set.seed(group_id)
means_3 <- replicate(1000, mean(sample(population, 3, replace = TRUE)))

hist(means_3, main = "Sampling Distribution (n = 3)")


