################################################################################
### Scatter plot ###

library(ggplot2)
library(rlang)

scatterplot <- function(data,
                        xvar,
                        yvar,
                        xlab = "X",
                        ylab = "Y") {
  
  xvar <- enquo(xvar)
  yvar <- enquo(yvar)
  
  ggplot(data, aes(x = {{ xvar }}, y = {{ yvar }})) +
    geom_point(
      color = "black",
      fill = "palegreen3",
      shape = 21,
      size = 2,
      alpha = 0.7
    ) +
    labs(x = xlab, y = ylab) +
    theme_minimal(base_size = 14) +
    theme(
      panel.grid = element_blank()
    )
}


