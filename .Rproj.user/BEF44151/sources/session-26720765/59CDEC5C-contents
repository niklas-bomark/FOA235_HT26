
################################################################################
### Histogram ###

library(ggplot2)

histogram <- function(x,
                      bins = 20,
                      xlab = "X",
                      ylab = "Count",
                      suffix = " kr") {
  
  ggplot(data.frame(x = x), aes(x)) +
    geom_histogram(
      bins = bins,
      fill = "palegreen3",
      color = "black"
    ) +
    scale_x_continuous(labels = label_number(big.mark = " ", decimal.mark = ",", suffix = suffix)) + 
    labs(x = xlab, y = ylab) +
    theme_minimal(base_size = 14) +
    theme(
      panel.grid = element_blank()
    )
}

